{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/news/:id", "destination": "/_/backend/api/news/share/:id" },
    { "source": "/category/:category", "destination": "/_/backend/api/news/share-category/:category" }
  ]
}
